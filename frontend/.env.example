# ==============================================================================
# MoodCart Frontend Environment Variables (Vercel & Development)
# ==============================================================================

# Backend API URL (Production Render URL: e.g. https://moodcart-backend.onrender.com)
VITE_API_URL=https://moodcart-backend.onrender.com

# Supabase Project Credentials (Anon/Public key ONLY - NEVER put service role key here)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
