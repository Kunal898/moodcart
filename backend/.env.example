# ==============================================================================
# MoodCart Backend Environment Variables (Production & Development)
# ==============================================================================

# Server Port (Render sets this dynamically, default: 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# Allowed Frontend Origins for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app,http://localhost:5173)
FRONTEND_URL=https://your-app.vercel.app

# Optional: allow *.vercel.app preview branches
ALLOW_VERCEL_PREVIEWS=true

# Supabase Project Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
